# Development
VOXELATLAS_ENV=development
VOXELATLAS_SESSION_SECRET=
VOXELATLAS_SECURE_COOKIES=false
VOXELATLAS_SESSION_COOKIE_NAME=voxelatlas_session
VOXELATLAS_ALLOWED_HOSTS=127.0.0.1,localhost
VOXELATLAS_DATA_DIR=data
VOXELATLAS_MAX_UPLOAD_MIB=512

# Authentication
VOXELATLAS_AUTH_USERNAME=
VOXELATLAS_AUTH_PASSWORD_HASH=
VOXELATLAS_SESSION_TTL_MINUTES=60

# Surface reconstruction
VOXELATLAS_SURFACE_PYTHON=
